generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  articles    Article[]
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  url            String?
  description    String
  longDesc       String?
  logo           String?
  screenshots    String[]
  categoryId     String
  tags           String[]
  pricing        String?
  pricingDetail  String?
  rating         Float         @default(0)
  reviewCount    Int           @default(0)
  monthlyTraffic Int?
  founded        String?
  company        String?
  location       String?
  features       Json?
  pros           String[]
  cons           String[]
  alternatives   String[]
  useCases       String[]
  status         ProductStatus @default(DRAFT)
  geoOptimized   Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  articles       Article[]
  category       Category      @relation(fields: [categoryId], references: [id])
  reviews        Review[]

  @@index([categoryId])
  @@index([rating(sort: Desc)])
  @@index([monthlyTraffic(sort: Desc)])
  @@index([status])
  @@index([publishedAt(sort: Desc)])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  authorUrl String?
  rating    Float
  title     String?
  content   String
  pros      String[]
  cons      String[]
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([rating])
}

model Article {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  type         ArticleType
  content      String
  excerpt      String?
  faqItems     Json?
  keywords     String[]
  metaTitle    String?
  metaDesc     String?
  schemaType   String?
  authorName   String      @default("AooBee 编辑部")
  authorUrl    String?
  readTime     Int?
  wordCount    Int?
  categoryId   String?
  productId    String?
  relatedSlugs String[]
  published    Boolean     @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category?   @relation(fields: [categoryId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])

  @@index([categoryId])
  @@index([type])
  @@index([published])
  @@index([publishedAt(sort: Desc)])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ArticleType {
  GUIDE
  COMPARISON
  REVIEW
  FAQ
  LISTICLE
  HOW_TO
  BEST
}
